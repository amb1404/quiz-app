    if (data.success) {
        liveToken = data.token;
        document.getElementById('live-auth-screen').style.display = 'none';
        document.getElementById('live-quiz-screen').style.display = 'block';
        fetchLiveQuestion(0);
    } else {
        alert(data.error);
        document.getElementById('live-auth-btn').innerText = "Join Live Test";
    }
});

async function fetchLiveQuestion(index) {
    document.getElementById('live-q-box').innerText = "Loading...";
    const res = await fetch(`/api/live/quiz/${currentQuizId}/question/${index}`, {
        headers: { 'Authorization': `Bearer ${liveToken}` }
    });
    const data = await res.json();
    totalQuestions = data.total;
    
    // Decrypt (requires xorDecipher from your main js)
    const q = JSON.parse(xorDecipher(data.payload, data.key));
    
    document.getElementById('live-q-box').innerText = `Q${index + 1}: ${q.question}`;
    const optsContainer = document.getElementById('live-opts');
    optsContainer.innerHTML = '';
    
    q.options.forEach((opt, idx) => {
        const btn = document.createElement('button');
        btn.innerText = opt;
        btn.onclick = () => submitLiveAnswer(index, idx, btn);
        optsContainer.appendChild(btn);
    });
}

async function submitLiveAnswer(qIndex, answerIdx, btnEl) {
    document.querySelectorAll('#live-opts button').forEach(b => b.disabled = true);
    btnEl.style.backgroundColor = '#dbeafe';

    await fetch('/api/live/submit-answer', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${liveToken}` },
        body: JSON.stringify({ questionIndex: qIndex, answer: answerIdx })
    });

    if (qIndex + 1 < totalQuestions) {
        currentIndex++;
        fetchLiveQuestion(currentIndex);
    } else {
        document.getElementById('live-q-box').innerText = "Test Complete! Awaiting admin review.";
        document.getElementById('live-opts').innerHTML = "";
    }
}

