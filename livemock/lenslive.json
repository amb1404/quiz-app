        const matched = list.find(n => n.class === selectedNotesClass && n.subject.toLowerCase() === subject.toLowerCase());
        container.innerHTML = '';
        if (matched?.notes?.length > 0) {
            matched.notes.forEach(note => createContentCard(note, 'notes', container));
