// A. Generate and Email the Shared Live OTP to Admin
app.post('/api/live/request-otp', async (req, res) => {
    try {
        const { quizId } = req.body;
        if (!quizId) return res.status(400).json({ error: 'Quiz ID required.' });
        
        const cleanId = path.basename(String(quizId)).trim();
        const otpKey = `live:otp:${cleanId}`;
        
        let otp = await stateStore.get(otpKey);
        if (!otp) {
            otp = crypto.randomInt(100000, 1000000).toString();
            await stateStore.set(otpKey, otp, 60 * 60 * 2); // Valid for 2 hours
            
            // Email the admin
            if (process.env.APP_SCRIPT_URL && APPS_SECRET) {
                fetch(process.env.APP_SCRIPT_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        type: 'otp', targetEmail: ADMIN_EMAIL, 
                        subject: `LIVE QUIZ OTP - ${cleanId}`, secretKey: APPS_SECRET,
                        breakdown: `<h3>Live Quiz OTP for ${cleanId}</h3><h1>${otp}</h1><p>Share this with your class. Valid for 2 hours.</p>`
                    })
                }).catch(err => console.error('Live OTP email error:', err));
            }
        }
        res.json({ success: true, message: 'OTP sent to Admin.' });
    } catch (err) {
        res.status(500).json({ error: 'Failed to request live OTP.' });
    }
});

// B. Verify Shared OTP and Grant Live Token
app.post('/api/live/verify-otp', async (req, res) => {
    try {
        const { firstName, lastName, quizId, otp } = req.body;
        const cleanId = path.basename(String(quizId)).trim();
        
        const activeOtp = await stateStore.get(`live:otp:${cleanId}`);
        if (!activeOtp || activeOtp !== String(otp).trim()) {
            return res.status(400).json({ error: 'Invalid or expired Live OTP.' });
        }

        const tokenData = `LIVE|${cleanId}|${encodeURIComponent(firstName)}|${encodeURIComponent(lastName)}|${Date.now()}`;
        const signature = crypto.createHmac('sha256', SECRET).update(tokenData).digest('hex');
        
        // Initialize student in the live leaderboard
        await stateStore.execCommand(['HSET', `live:board:${cleanId}`, `${firstName} ${lastName}`, JSON.stringify({ joinedAt: Date.now(), answers: [] })]);
        await stateStore.execCommand(['EXPIRE', `live:board:${cleanId}`, String(60 * 60 * 4)]);

        res.json({ success: true, token: `${tokenData}|||${signature}` });
    } catch (err) {
        res.status(500).json({ error: 'Verification failed.' });
    }
});

// C. Live JIT Question Delivery (Unshuffled)
app.get('/api/live/quiz/:id/question/:index', async (req, res) => {
    try {
        const authHeader = req.get('Authorization');
        if (!authHeader) return res.status(401).json({ error: 'Missing token' });
        
        const token = authHeader.replace('Bearer ', '');
        const [tokenData, signature] = token.split('|||');
        const expectedSig = crypto.createHmac('sha256', SECRET).update(tokenData).digest('hex');
        if (!safeCompareHex(signature, expectedSig)) return res.status(401).json({ error: 'Invalid token' });

        const cleanId = path.basename(String(req.params.id)).trim();
        const index = parseInt(req.params.index, 10);
        
        const filePath = resolveSafeQuizPath(cleanId);
        const content = getCachedQuizContent(filePath);
        const rawQuestions = content.questions || [];
        
        if (index < 0 || index >= rawQuestions.length) return res.status(400).json({ error: "Invalid index." });

        // NO PERMUTATION/SHUFFLING FOR LIVE MODE
        const q = rawQuestions[index];
        const sanitized = { type: q.type || 'mcq', question: q.question, options: q.options || [] };
        
        const singleUseKey = crypto.randomBytes(12).toString('hex');
        res.json({ payload: xorCipher(JSON.stringify(sanitized), singleUseKey), key: singleUseKey, total: rawQuestions.length });
    } catch {
        res.status(500).json({ error: "Failed to fetch live question." });
    }
});

// D. Record Live Answers in Real-Time
app.post('/api/live/submit-answer', async (req, res) => {
    try {
        const authHeader = req.get('Authorization');
        const token = authHeader.replace('Bearer ', '');
        const [tokenData] = token.split('|||');
        const [, quizId, first, last] = tokenData.split('|');
        const fullName = `${decodeURIComponent(first)} ${decodeURIComponent(last)}`;

        const { questionIndex, answer } = req.body;
        
        const boardKey = `live:board:${quizId}`;
        const rawStudentData = await stateStore.execCommand(['HGET', boardKey, fullName]);
        
        let studentData = rawStudentData ? JSON.parse(rawStudentData) : { joinedAt: Date.now(), answers: [] };
        studentData.answers[questionIndex] = { answer, time: Date.now() };
        
        await stateStore.execCommand(['HSET', boardKey, fullName, JSON.stringify(studentData)]);
        res.json({ success: true });
    } catch {
        res.status(500).json({ error: "Failed to record answer." });
    }
});

// E. Admin Dashboard Feed (Requires Admin Secret)
app.get('/api/live/dashboard/:id', async (req, res) => {
    try {
        const { adminKey } = req.query;
        if (adminKey !== process.env.APPS_SCRIPT_SECRET) return res.status(403).json({ error: 'Unauthorized Admin' });

        const cleanId = path.basename(String(req.params.id)).trim();
        const rawData = await stateStore.execCommand(['HGETALL', `live:board:${cleanId}`]);
        
        const leaderboard = [];
        for (let i = 0; i < rawData.length; i += 2) {
            leaderboard.push({ name: rawData[i], data: JSON.parse(rawData[i+1]) });
        }
        
        // Sort by most recent activity (attempt time)
        leaderboard.sort((a, b) => {
            const aLast = a.data.answers.length > 0 ? a.data.answers[a.data.answers.length - 1]?.time || 0 : 0;
            const bLast = b.data.answers.length > 0 ? b.data.answers[b.data.answers.length - 1]?.time || 0 : 0;
            return bLast - aLast; 
        });

        res.json({ success: true, leaderboard });
    } catch {
        res.status(500).json({ error: "Failed to fetch dashboard feed." });
    }
});

